{
  "name": "syntaxis",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "format": "prettier --write . --ignore-unknown --no-error-on-unmatched-pattern",
    "format:check": "prettier --check . --ignore-unknown --no-error-on-unmatched-pattern",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nx": "^24.0.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10.0.0"
  }
}
